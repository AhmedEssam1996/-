// ============================================================================
// Hadiya (هدية) — Environment Configuration
// Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
// ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (database + authentication)
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (used by the migration/seed scripts only).
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI — OpenRouter (server-side only)
# ---------------------------------------------------------------------------
# NEVER prefix this with NEXT_PUBLIC_. All AI calls happen in server routes.
OPENROUTER_API_KEY=
# Change the model without touching application code.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Hadiya
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_TEMPERATURE=0.85
OPENROUTER_MAX_TOKENS=2400
# `openrouter` (default when a key is present) or `mock`.
# `mock` uses a deterministic offline provider so the app is fully explorable
# without a key. It is REFUSED in production — see src/lib/ai/provider.ts.
AI_PROVIDER=

# ---------------------------------------------------------------------------
# AI usage limits (business rules — never hardcoded in components)
# Admin can override these at runtime from /admin/settings.
# ---------------------------------------------------------------------------
FREE_DAILY_AI_LIMIT=10
FREE_MONTHLY_AI_LIMIT=120
AI_RATE_LIMIT_PER_MINUTE=6

# ---------------------------------------------------------------------------
# Initial admin bootstrap
# The account with this email is promoted to ADMIN exactly once, through
# POST /api/admin/bootstrap (requires ADMIN_BOOTSTRAP_TOKEN) or `npm run admin:promote`.
# Never hardcode an admin email in the client bundle.
# ---------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=
ADMIN_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
MAINTENANCE_MODE=false

# ---------------------------------------------------------------------------
# Stripe (commerce) — server-only
# ---------------------------------------------------------------------------
# Read by src/lib/env.ts and required by /api/commerce/checkout and the webhook.
# They were missing from this template even though the code already depends on
# them, so a deployment configured only from .env.example would boot with
# commerce silently disabled.
#
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is the only one that reaches the browser.
# The secret key and the webhook secret must never be prefixed NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Any ISO currency code; Stripe requires lowercase at the API boundary.
STRIPE_CURRENCY=usd

# ---------------------------------------------------------------------------
# Netlify (only needed on deploy — safe to leave blank locally)
# ---------------------------------------------------------------------------
# The deployed origin. Used for OpenRouter attribution, canonical URLs, the
# sitemap and the robots.txt host. This MUST be the https:// production URL:
# leaving it as http://localhost:3000 makes the sitemap advertise localhost to
# search engines and breaks the Stripe redirect allow-list.
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app
